{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm drizzle-kit migrate && pnpm run build",
  "outputDirectory": "dist/public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "dist/server/**"
    }
  }
}
