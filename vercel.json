{
  "buildCommand": "pnpm drizzle-kit migrate && pnpm run build",
  "outputDirectory": "dist/public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 10,
      "includeFiles": "{dist/server/**,node_modules/.pnpm/web-tree-sitter@*/node_modules/web-tree-sitter/**,node_modules/.pnpm/@codebuff+sdk@*/node_modules/@codebuff/sdk/dist/wasm/**}"
    }
  }
}
